---
import T from './ui/T.astro';
---

<span class="inline-flex items-center gap-2.5 rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1.5 text-sm font-medium text-ink">
  <span class="relative flex size-2.5">
    <span class="absolute inline-flex size-full rounded-full bg-accent opacity-75 motion-safe:animate-ping"></span>
    <span class="relative inline-flex size-2.5 rounded-full bg-accent"></span>
  </span>
  <T k="hero.badge" />
</span>
