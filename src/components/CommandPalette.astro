---
import { CornerDownLeft, Search } from '@lucide/astro';
import T from './ui/T.astro';
import Brand from './ui/Brand.astro';
import { commandGroups } from '../data/commands';
import { t } from '../i18n';
---

<dialog id="palette" class="palette" aria-label="Command palette" data-ph-en={t('en', 'palette.placeholder')} data-ph-es={t('es', 'palette.placeholder')}>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Search size={18} class="shrink-0 text-muted" />
    <input
      id="palette-input" type="text" autocomplete="off" spellcheck="false" role="combobox"
      aria-expanded="true" aria-controls="palette-list" placeholder={t('en', 'palette.placeholder')}
      class="h-14 w-full bg-transparent text-base outline-none placeholder:text-muted"
    />
    <kbd class="kbd">Esc</kbd>
  </div>

  <div id="palette-list" role="listbox" class="max-h-[55vh] min-h-48 overflow-y-auto p-2">
    {commandGroups.map((group) => (
      <div data-group role="presentation">
        <T as="p" block k={group.title} class="px-3 pb-1 pt-3 font-mono text-[0.68rem] uppercase tracking-widest text-muted" />
        <ul>
          {group.items.map((item) => (
            <li>
              <button type="button" role="option" aria-selected="false" class="palette-item"
                data-cmd={item.cmd} data-arg={item.arg} data-keywords={item.keywords}>
                {item.brand
                  ? <Brand name={item.brand} class="text-[1.1rem] text-muted" />
                  : item.icon && <item.icon size={18} class="shrink-0 text-muted" />}
                <T k={item.label} />
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <T as="p" block k="palette.empty" class="hidden px-3 py-10 text-center text-sm text-muted" data-empty />
  </div>

  <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 text-xs text-muted">
    <span class="inline-flex items-center gap-1.5"><kbd class="kbd !min-w-0">↑↓</kbd><T k="palette.hintMove" /></span>
    <span class="inline-flex items-center gap-1.5"><kbd class="kbd !min-w-0"><CornerDownLeft size={11} /></kbd><T k="palette.hintSelect" /></span>
  </div>
</dialog>
