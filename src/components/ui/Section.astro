---
import T from './T.astro';
import type { UiKey } from '../../i18n';
import type { Icon } from '../../types';

interface Props {
  id: string;
  index: string;
  icon: Icon;
  title: UiKey;
  subtitle?: UiKey;
}

const { id, index, icon: IconComponent, title, subtitle } = Astro.props;
---

<section id={id} data-section class="relative mx-auto max-w-6xl px-5 py-20 md:py-28">
  <header class="reveal mb-10 md:mb-14">
    <div class="mb-4 flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted">
      <span class="grid size-9 place-items-center rounded-xl border border-line bg-surface text-accent">
        <IconComponent size={18} />
      </span>
      <span>{index}</span>
      <span class="h-px w-10 bg-line"></span>
    </div>
    <T as="h2" block k={title} class="font-display text-4xl font-semibold tracking-tight md:text-6xl" />
    {subtitle && <T as="p" block k={subtitle} class="mt-4 max-w-2xl text-lg text-muted" />}
  </header>
  <slot />
</section>
